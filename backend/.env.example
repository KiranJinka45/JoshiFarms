# ==============================================================================
# Farm Fresh Dairy — Backend Environment Configuration
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Farm Fresh Dairy API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate via: openssl rand -hex 32
SECRET_KEY="super-secret-jwt-signing-key-change-in-production-min-32-chars"
PEPPER_SECRET="ffd_deterministic_phone_pepper_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM="HS256"

# Development Flags (MUST BE FALSE IN PRODUCTION)
ALLOW_DEV_OTP=true

# Database (PostgreSQL 16 via asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:secretpassword@127.0.0.1:5439/farm_fresh_dairy"

# ------------------------------------------------------------------------------
# Stage B External Gateways (Fill when ready to test live external endpoints)
# ------------------------------------------------------------------------------

# Razorpay Test Mode Sandbox Credentials (Get from https://dashboard.razorpay.com/#/access/api_keys)
RAZORPAY_KEY_ID="rzp_test_replace_with_actual_key_id"
RAZORPAY_KEY_SECRET="replace_with_actual_key_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_replace_with_actual_webhook_secret"

# Meta Cloud API for WhatsApp OTP (Get from https://developers.facebook.com)
WHATSAPP_API_TOKEN="EAAG_replace_with_meta_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="replace_with_meta_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="replace_with_waba_id"
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
MAX_EXTERNAL_TEST_MESSAGES=10

# Business Domain Rules
CUTOFF_HOURS=7
FREE_DELIVERY_THRESHOLD_PAISE=10000
DEFAULT_DELIVERY_FEE_PAISE=1500
